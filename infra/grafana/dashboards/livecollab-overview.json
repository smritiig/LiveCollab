{
  "id": null,
  "uid": "livecollab-overview",
  "title": "LiveCollab Reliability Overview",
  "tags": ["livecollab", "observability", "websocket", "redis"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active WebSockets",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(livecollab_websocket_connections)", "refId": "A"}],
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Operation Rate / sec",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(livecollab_operations_total[1m]))", "refId": "A"}],
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Sequence Gaps (5m)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(increase(livecollab_sequence_gaps_total[5m]))", "refId": "A"}],
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Stale Writes Rejected (5m)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(increase(livecollab_stale_write_rejections_total[5m]))", "refId": "A"}],
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Operation p95 Latency",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(livecollab_operation_duration_seconds_bucket[2m])))", "legendFormat": "p95", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Redis Command p95 Latency",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(livecollab_redis_command_duration_seconds_bucket[2m])))", "legendFormat": "p95", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Redis Stream Propagation Lag p95",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(livecollab_stream_propagation_lag_seconds_bucket[2m])))", "legendFormat": "p95", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Reconnect Recovery",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum(increase(livecollab_resume_success_total[5m]))", "legendFormat": "successful resumes", "refId": "A"},
        {"expr": "sum(increase(livecollab_resume_failures_total[5m]))", "legendFormat": "failed resumes", "refId": "B"},
        {"expr": "sum(increase(livecollab_replayed_events_total[5m]))", "legendFormat": "replayed events", "refId": "C"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Backend HTTP p95 Latency",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(livecollab_http_request_duration_seconds_bucket[2m])))", "legendFormat": "p95", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Redis Errors",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (instance_id) (rate(livecollab_redis_errors_total[1m]))", "legendFormat": "{{instance_id}}", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20}
    }
  ]
}
